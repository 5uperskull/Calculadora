<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/txt"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/modeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_off"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/bg"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/targetLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:textColor="@color/ice"
            android:textSize="12sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/linesScroll"
            android:layout_width="match_parent"
            android:layout_height="170dp">

            <LinearLayout
                android:id="@+id/lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/primaryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnInsert"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:background="@drawable/bg_button_primary"
                android:textColor="@color/txt"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnManual"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="@string/manual"
                android:textColor="@color/ice"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="@string/deshacer"
                android:textColor="@color/txt"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="@string/reiniciar"
                android:textColor="@color/txt"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="@string/salir"
                android:textColor="@color/dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Teclado propio: son toques sobre una ventana sin foco, asi que el
             cursor del WMS no se mueve y no sube el teclado del sistema. -->
        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/manualValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:fontFamily="monospace"
                android:gravity="end|center_vertical"
                android:minHeight="52dp"
                android:padding="10dp"
                android:textColor="@color/txt"
                android:textSize="26sp"
                android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/key7"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="7"
                android:textColor="@color/txt"
                android:textSize="19sp" />
            <Button
                android:id="@+id/key8"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="8"
                android:textColor="@color/txt"
                android:textSize="19sp" />
            <Button
                android:id="@+id/key9"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="9"
                android:textColor="@color/txt"
                android:textSize="19sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/key4"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="4"
                android:textColor="@color/txt"
                android:textSize="19sp" />
            <Button
                android:id="@+id/key5"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="5"
                android:textColor="@color/txt"
                android:textSize="19sp" />
            <Button
                android:id="@+id/key6"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="6"
                android:textColor="@color/txt"
                android:textSize="19sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/key1"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="1"
                android:textColor="@color/txt"
                android:textSize="19sp" />
            <Button
                android:id="@+id/key2"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="2"
                android:textColor="@color/txt"
                android:textSize="19sp" />
            <Button
                android:id="@+id/key3"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="3"
                android:textColor="@color/txt"
                android:textSize="19sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/keySep"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text=","
                android:textColor="@color/txt"
                android:textSize="19sp" />
            <Button
                android:id="@+id/key0"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="0"
                android:textColor="@color/txt"
                android:textSize="19sp" />
            <Button
                android:id="@+id/keyDel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="&#8592;"
                android:textColor="@color/txt"
                android:textSize="19sp" />
        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnManualCancel"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:text="@string/cancelar"
                    android:textColor="@color/dim"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnManualAdd"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/agregar"
                    android:textColor="@color/txt"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
