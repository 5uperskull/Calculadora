            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.08"
            android:text="LECTOR"
            android:textColor="@color/corp_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
