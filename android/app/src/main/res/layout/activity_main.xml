                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_light"
                android:text="Preset Zebra"
                android:textAllCaps="false"
                android:textColor="@color/corp_navy"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnHoneywell"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_light"
                android:text="Preset Honeywell"
                android:textAllCaps="false"
                android:textColor="@color/corp_navy"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.08"
            android:text="PERFIL DE DATAWEDGE"
            android:textColor="@color/corp_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
